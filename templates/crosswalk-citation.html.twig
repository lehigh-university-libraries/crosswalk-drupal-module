<div class="crosswalk-citation" {% if csl_json %}data-crosswalk-csl="{{ csl_json|e('html_attr') }}"{% endif %}>
  <ul class="nav nav-tabs" role="tablist">
    {% if csl_json %}
      <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-crosswalk-tab="apa" type="button" role="tab" aria-selected="true">APA</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-crosswalk-tab="mla" type="button" role="tab" aria-selected="false">MLA</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-crosswalk-tab="chicago" type="button" role="tab" aria-selected="false">Chicago</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-crosswalk-tab="csl-json" type="button" role="tab" aria-selected="false">CSL-JSON</button>
      </li>
    {% endif %}
    {% if bibtex %}
      <li class="nav-item" role="presentation">
        <button class="nav-link{{ not csl_json ? ' active' }}" data-bs-toggle="tab" data-crosswalk-tab="bibtex" type="button" role="tab" aria-selected="{{ not csl_json ? 'true' : 'false' }}">BibTeX</button>
      </li>
    {% endif %}
    {% if schemaorg %}
      <li class="nav-item" role="presentation">
        <button class="nav-link{{ not csl_json and not bibtex ? ' active' }}" data-bs-toggle="tab" data-crosswalk-tab="schemaorg" type="button" role="tab" aria-selected="{{ not csl_json and not bibtex ? 'true' : 'false' }}">Schema.org</button>
      </li>
    {% endif %}
  </ul>
  <div class="tab-content pt-3">
    {% if csl_json %}
      <div class="tab-pane fade show active" data-crosswalk-pane="apa" role="tabpanel">
        <div class="crosswalk-citation-apa"></div>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2 crosswalk-copy" data-crosswalk-copy="apa" title="Copy to clipboard"><span class="material-symbols-outlined">content_copy</span><span class="crosswalk-copy-fallback">Copy</span></button>
      </div>
      <div class="tab-pane fade" data-crosswalk-pane="mla" role="tabpanel">
        <div class="crosswalk-citation-mla"></div>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2 crosswalk-copy" data-crosswalk-copy="mla" title="Copy to clipboard"><span class="material-symbols-outlined">content_copy</span><span class="crosswalk-copy-fallback">Copy</span></button>
      </div>
      <div class="tab-pane fade" data-crosswalk-pane="chicago" role="tabpanel">
        <div class="crosswalk-citation-chicago"></div>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2 crosswalk-copy" data-crosswalk-copy="chicago" title="Copy to clipboard"><span class="material-symbols-outlined">content_copy</span><span class="crosswalk-copy-fallback">Copy</span></button>
      </div>
      <div class="tab-pane fade" data-crosswalk-pane="csl-json" role="tabpanel">
        <pre class="crosswalk-csl-json"></pre>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2 crosswalk-copy" data-crosswalk-copy="csl-json" title="Copy to clipboard"><span class="material-symbols-outlined">content_copy</span><span class="crosswalk-copy-fallback">Copy</span></button>
      </div>
    {% endif %}
    {% if bibtex %}
      <div class="tab-pane fade{{ not csl_json ? ' show active' }}" data-crosswalk-pane="bibtex" role="tabpanel">
        <pre class="crosswalk-bibtex">{{ bibtex }}</pre>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2 crosswalk-copy" data-crosswalk-copy="bibtex" title="Copy to clipboard"><span class="material-symbols-outlined">content_copy</span><span class="crosswalk-copy-fallback">Copy</span></button>
      </div>
    {% endif %}
    {% if schemaorg %}
      <div class="tab-pane fade{{ not csl_json and not bibtex ? ' show active' }}" data-crosswalk-pane="schemaorg" role="tabpanel">
        <script type="application/ld+json" class="crosswalk-schemaorg">{{ schemaorg|raw }}</script>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2 crosswalk-copy" data-crosswalk-copy="schemaorg" title="Copy to clipboard"><span class="material-symbols-outlined">content_copy</span><span class="crosswalk-copy-fallback">Copy</span></button>
      </div>
    {% endif %}
  </div>
</div>
